      "id": "H01",
      "title": "默认详略的同义重述",
      "initial_memory": "# 用户偏好\n- 工作汇报先给简短结论，需要时再展开细节。\n",
      "rounds": [
        {
          "scope": {
            "space": "productivity",
            "project": "holdout",
            "work_item": "report"
          },
          "refresh_snapshot": false,
          "messages": [
            {
              "id": "h01-1",
              "role": "user",
              "content": "工作汇报还是照旧，先简短说结论，有需要再讲细节。"
            }
          ],
          "expectations": {
            "change": "unchanged",
            "snapshot": "off",
            "must_keep": [
              "原有先简短结论的偏好原文"
            ],
            "must_not": [
              "重复或无谓改写"
            ]
          }
        }
      ]
