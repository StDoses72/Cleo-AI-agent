{
  "manifest_version": 3,
  "name": "Cleo",
  "version": "1.0.0",
  "description": "Lets the Cleo desktop app work in tabs you choose, in the background, with your permission per website.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "alarms"
  ],
  "icons": {
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Cleo"
  }
}
