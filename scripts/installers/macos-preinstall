#!/bin/sh
set -eu
if [ "${3:-/}" != / ]; then
    echo 'Install Cleo on the running macOS system volume.' >&2
    exit 1
fi
architecture=$(uname -m)
if [ "$(sysctl -in hw.optional.arm64 2>/dev/null || true)" = 1 ]; then architecture=arm64; fi
case "$architecture" in
    arm64) target=macos-arm64 ;;
    x86_64) target=macos-x64 ;;
    *) echo 'This Mac architecture is not supported.' >&2; exit 1 ;;
esac
if [ "$target" != '@TARGET@' ]; then
    echo "Wrong installer for this Mac. Download Cleo-$target.pkg." >&2
    exit 1
fi
if pgrep -x Cleo >/dev/null; then
    echo 'Quit Cleo before installing this version.' >&2
    exit 1
fi
